{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(uv *)",
      "Bash(make *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git -C *)",
      "Bash(bash scripts/smoke.sh*)",
      "Bash(./demo.sh*)",
      "Bash(bash tests/run.sh*)",
      "Bash(curl *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh repo view *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Bash(gh pr merge *)",
      "PowerShell(*)",
      "Bash(git push *)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "Bash(gh pr merge*)",
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(git -C * push*)",
      "Bash(git --git-dir*)",
      "Bash(git -c *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "*.pythonhosted.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "playwright.azureedge.net"
      ]
    }
  },
  "attribution": {
    "sessionUrl": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/stop_hook.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
